# Get a key from Google AI Studio (gemini-4-argon needs a project with billing enabled)
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-4-argon
# low | medium | high. Low keeps replies quick; the answers are short anyway.
GEMINI_THINKING_LEVEL=low

# Set to 1 to run the UI without calling Gemini (canned replies). The crisis check still runs for real.
COACH_MOCK=0
